  "intro": [
    {
      "id": "tqt.intro.1",
      "vi": "Ngày xưa, thời nhà Trần, có một cậu bé tên là Trần Quốc Toản.",
      "en": "Long ago, in the time of the Trần dynasty, there was a boy named Trần Quốc Toản.",
      "claims": [
        "C01"
      ]
    },
    {
      "id": "tqt.intro.2",
      "vi": "Quân Mông–Nguyên chuẩn bị sang xâm lược Đại Việt.",
      "en": "The Mông–Nguyên army was getting ready to invade Đại Việt.",
      "claims": [
        "C03"
      ]
    },
    {
      "id": "tqt.intro.3",
      "vi": "Vua Trần họp các vương hầu ở bến Bình Than để bàn việc đánh giặc.",
      "en": "The Trần king gathered his lords at Bình Than to plan the defence.",
      "claims": [
        "C04"
      ]
    },
    {
      "id": "tqt.intro.4",
      "vi": "Quốc Toản còn nhỏ tuổi nên không được vào dự bàn.",
      "en": "Quốc Toản was too young, so he was not allowed into the meeting.",
      "claims": [
        "C05"
      ]
    },
    {
      "id": "tqt.intro.5",
      "vi": "Truyện kể rằng cậu tức quá, bóp nát quả cam vua ban lúc nào không biết.",
      "en": "The story says he was so upset that he crushed the king's orange without noticing.",
      "claims": [
        "C06"
      ]
    },
    {
      "id": "tqt.intro.6",
      "vi": "Quốc Toản về nhà, tập hợp người thân và gia nhân cùng luyện võ.",
      "en": "Quốc Toản went home and trained his family and helpers to fight.",
      "claims": [
        "C07"
      ]
    },
    {
      "id": "tqt.intro.7",
      "vi": "Truyện kể rằng cậu may một lá cờ thêu sáu chữ vàng.",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galaxyandsun.com/daidatanhhung/content/mission.schema.json",
  "title": "One hero's mission: intro, beats, ending.",
  "type": "object",
  "required": [
    "schema_version",
    "hero",
    "next_hero",
    "intro",
    "beats",
    "ending"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "hero": {
      "type": "object",
      "required": [
        "id",
        "name",
        "timeline_order",
        "place"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/HeroId"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/Text"
        },
        "timeline_order": {
          "description": "Heroes unlock in historical order.",
          "type": "integer",
          "minimum": 1
        },
        "place": {
          "description": "Where the story happened, shown on the map.",
          "$ref": "common.schema.json#/$defs/Text"
        }
      }
    },
    "next_hero": {
      "description": "Hero unlocked by finishing the quiz; null for the last hero shipped.",
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/HeroId"
        },
        {
          "type": "null"
        }
      ]
    },
    "intro": {
      "$ref": "common.schema.json#/$defs/TextList"
    },
    "banner": {
      "description": "Defined once; beats with uses_banner show it. A text layer, never baked into art.",
      "$ref": "common.schema.json#/$defs/Text"
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Beat"
      }
    },
    "ending": {
      "type": "object",
      "required": [
        "lines",
        "picture_id"
      ],
      "additionalProperties": false,
      "properties": {
        "lines": {
          "$ref": "common.schema.json#/$defs/TextList"
        },
        "picture_id": {
          "$ref": "common.schema.json#/$defs/Id"
        }
      }
    }
  },
  "$defs": {
    "Button": {
      "enum": [
        "move",
        "attack",
        "defend",
        "special"
      ]
    },
    "Beat": {
      "type": "object",
      "required": [
        "id",
        "type",
        "buttons",
        "title",
        "scene",
        "params",
        "theme"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "type": {
          "enum": [
            "fight",
            "walk",
            "hold-meter",
            "training",
            "reach-the-flag",
            "dialogue"
          ]
        },
        "buttons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Button"
          }
        },
        "title": {
          "$ref": "common.schema.json#/$defs/Text"
        },
        "scene": {
          "description": "One sentence per box. May be empty only for a dialogue beat (schema 1.4).",
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Text"
          }
        },
        "goal": {
          "$ref": "common.schema.json#/$defs/Text"
        },
        "uses_banner": {
          "type": "boolean",
          "default": false
        },
        "params": {
          "type": "object"
        },
        "theme": {
          "description": "Background set; a stand-in place, no history claim.",
          "enum": [
            "village",
            "bamboo",
            "river",
            "camp"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "fight"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/FightParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "walk"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/DistanceParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reach-the-flag"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/ReachParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hold-meter"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/HoldParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "training"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/TrainingParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dialogue"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/DialogueParams"
              },
              "buttons": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dialogue"
              }
            }
          },
          "else": {
            "required": [
              "goal"
            ],
            "properties": {
              "buttons": {
                "minItems": 1
              },
              "scene": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "FightParams": {
      "type": "object",
      "required": [
        "enemies",
        "max_active",
        "from_left"
      ],
      "additionalProperties": false,
      "properties": {
        "enemies": {
          "description": "Walk-in order.",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "enum": [
              "spear",
              "shield",
              "leader"
            ]
          }
        },
        "max_active": {
          "description": "How many may be on screen at once.",
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "from_left": {
          "description": "Indexes in enemies[] that walk in from behind.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "DistanceParams": {
      "type": "object",
      "required": [
        "length_screens"
      ],
      "additionalProperties": false,
      "properties": {
        "length_screens": {
          "description": "Level length in screen widths.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        }
      }
    },
    "HoldParams": {
      "type": "object",
      "required": [
        "hold_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "hold_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        }
      }
    },
    "TrainingParams": {
      "type": "object",
      "required": [
        "dummies"
      ],
      "additionalProperties": false,
      "properties": {
        "dummies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "blocks": {
          "description": "Defend parts after the dummies (0 = none). Schema 1.1.",
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "finish_special": {
          "description": "Ends with one Special. Order: dummies -> blocks -> special. Schema 1.1.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "Encounter": {
      "description": "A fight met on the way, at a point along the level (schema 1.1). at_screen < length_screens is rule R13b.",
      "type": "object",
      "required": [
        "at_screen",
        "enemies",
        "max_active",
        "from_left"
      ],
      "additionalProperties": false,
      "properties": {
        "at_screen": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "enemies": {
          "$ref": "#/$defs/FightParams/properties/enemies"
        },
        "max_active": {
          "$ref": "#/$defs/FightParams/properties/max_active"
        },
        "from_left": {
          "$ref": "#/$defs/FightParams/properties/from_left"
        }
      }
    },
    "ReachParams": {
      "type": "object",
      "required": [
        "length_screens"
      ],
      "additionalProperties": false,
      "properties": {
        "length_screens": {
          "description": "Level length in screen widths.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "encounters": {
          "description": "Sorted by at_screen, strictly ascending (rule R13b). Schema 1.1.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Encounter"
          }
        }
      }
    },
    "DialogueLine": {
      "type": "object",
      "required": [
        "speaker",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "speaker": {
          "description": "narrator (no portrait), hero (the mission's hero, left), or another speaker id (right). Portrait: pic.portrait_<hero_id>_<speaker>[_<mood>].",
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "mood": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "text": {
          "$ref": "common.schema.json#/$defs/Text"
        }
      }
    },
    "DialogueParams": {
      "description": "Schema 1.4 (TASK-016). The button is the ask button while at_line <= L < at_line + taps (L = 1-based line showing); R13d: at_line + taps <= lines.",
      "type": "object",
      "required": [
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/DialogueLine"
          }
        },
        "ask": {
          "type": "object",
          "required": [
            "button",
            "taps",
            "at_line"
          ],
          "additionalProperties": false,
          "properties": {
            "button": {
              "description": "The hero's action line (a story Text with claims; R8c field button).",
              "$ref": "common.schema.json#/$defs/Text"
            },
            "taps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "at_line": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}

            "mood": "determined"
          },
          {
            "speaker": "hero",
            "text": {
              "id": "tqt.d1.line.7",
              "vi": "Cho giặc mượn đường là mất nước!",
              "en": "Letting the enemy pass means losing our country!",
              "claims": [
                "C16"
              ]
            },
            "mood": "determined"
          },
          {
            "speaker": "king",
            "text": {
              "id": "tqt.d1.line.8",
              "vi": "Cháu còn trẻ mà đã biết lo cho đất nước, ta khen cháu.",

  "intro": [
    {
      "id": "tqt.intro.1",
      "vi": "Ngày xưa, thời nhà Trần, có một cậu bé tên là Trần Quốc Toản.",
      "en": "Long ago, in the time of the Trần dynasty, there was a boy named Trần Quốc Toản.",
      "claims": [
        "C01"
      ]
    },
    {
      "id": "tqt.intro.2",
      "vi": "Năm ấy, quân Mông–Nguyên chuẩn bị sang xâm lược Đại Việt.",
      "en": "That year, the Mông–Nguyên army was getting ready to invade Đại Việt.",
      "claims": [
        "C03"
      ]
    },
    {
      "id": "tqt.intro.3",
      "vi": "Năm ấy, Trần Quốc Toản mới 15 tuổi.",

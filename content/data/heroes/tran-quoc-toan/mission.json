      "claims": [
        "C13"
      ]
    },
    {
      "id": "tqt.intro.4",
      "vi": "Vua Trần họp các vương hầu và trăm quan ở bến Bình Than để bàn việc đánh giặc.",
      "en": "The Trần king called his lords and officials to Bình Than to plan the defence.",
      "claims": [
        "C04"
      ]
    }
